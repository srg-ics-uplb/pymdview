#!/usr/bin/env python3
"""Launcher for PyMDView.

Finds the `pymdview` package next to wherever this script is installed:
  /usr/bin/pymdview        → /usr/share/pymdview/pymdview/      (.deb)
  ~/.local/bin/pymdview    → ~/.local/share/pymdview/pymdview/  (install.sh)
  <repo>/bin/pymdview      → <repo>/pymdview/                   (running from source)
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _root in (os.path.join(_here, "..", "share", "pymdview"), os.path.join(_here, "..")):
    if os.path.isfile(os.path.join(_root, "pymdview", "__init__.py")):
        sys.path.insert(0, os.path.normpath(_root))
        break

from pymdview.app import main  # noqa: E402

sys.exit(main())
